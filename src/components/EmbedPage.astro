---
/** Page intégrable (iframe) : le vérificateur seul, sans navigation. noindex, hors sitemap. */
import '../styles/global.css';
import ToolSlot from './ToolSlot.astro';
import { SITE_URL, LANG_TAGS, SITE_NAMES } from '../data/site-config';
import { route, type Locale } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { EMBED } from '../lib/embed';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = helpers(lang);
const home = `${SITE_URL}${route('home', lang)}`;
const dests = H.T({ en: ['GB'], fr: ['GB'], de: ['US', 'GB'], nl: ['US', 'GB'] }) as Array<'GB' | 'US'>;
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{EMBED[lang].title} – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><ToolSlot spec={{ kind: 'checker', dests }} lang={lang} id="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={home} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {H.T({ en: 'official fees read from government sources', fr: 'prix officiels relus aux sources gouvernementales', de: 'amtliche Gebühren aus den Quellen der Regierungen', nl: 'officiële tarieven uit overheidsbronnen' })}</p>
  </body>
</html>
